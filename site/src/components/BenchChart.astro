---
// The benchmarks on Linux (reference/benchmarks): seconds to make each
// tileset as PMTiles, medians of three runs, by dataset. manby's bars are the
// accent, tippecanoe's the gray they are measured against; both colors were
// checked for contrast and colorblind separation.
const datasets = [
	{
		name: '4 million random points',
		about: '556 MB of GeoJSON, clustered around 2,000 random centers',
		runs: [
			{
				name: 'dropping the densest as needed',
				options: '-zg --drop-densest-as-needed',
				manby: [5.86, 994],
				tippecanoe: [88.5, 1088],
			},
			{
				name: 'clustered within 10 pixels, values summed',
				options: '-zg -r1 --cluster-distance=10 --cluster-densest-as-needed --accumulate-attribute=value:sum',
				manby: [6.02, 974],
				tippecanoe: [82.5, 1028],
			},
			{
				name: 'clustering the densest as needed',
				options: '-zg --cluster-densest-as-needed',
				manby: [6.37, 1000],
				tippecanoe: [89.6, 1165],
			},
			{
				name: 'clustered at every zoom, values summed',
				options: '-zg -r1 --cluster-densest-as-needed --accumulate-attribute=value:sum',
				manby: [13.9, 1152],
				tippecanoe: [133.6, 1498],
			},
		],
	},
	{
		name: '17,522 US primary roads',
		about: 'TIGER/Line 2024',
		runs: [
			{
				name: 'to z14, 122,725 tiles',
				options: '-z14 -Z0 --drop-densest-as-needed',
				manby: [1.51, 236],
				tippecanoe: [59.0, 240],
			},
		],
	},
	{
		name: '85,186 US census tracts',
		about: 'Census cartographic boundaries 2023',
		runs: [
			{
				name: 'to z12, 312,073 tiles',
				options: '-z12 -Z0 --coalesce-densest-as-needed',
				manby: [7.77, 360],
				tippecanoe: [196.8, 456],
			},
			{
				name: 'coalescing the densest as needed',
				options: '-zg --coalesce-densest-as-needed',
				manby: [4.46, 379],
				tippecanoe: [36.1, 451],
			},
		],
	},
];
const max = 200;
const programs = [
	{ key: 'manby', color: 'bg-[#2a78d6] dark:bg-[#3987e5]' },
	{ key: 'tippecanoe', color: 'bg-[#898781]' },
] as const;
const benchmarks = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/reference/benchmarks/`;
const seconds = (s: number) => (s < 10 ? s.toFixed(1) : s.toFixed(0)) + ' s';
---

<figure class="not-content mt-10 mb-4">
	<figcaption class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
		<span class="text-base font-semibold text-gray-900 dark:text-gray-100">
			Seconds to make each tileset, on Linux
		</span>
		<span class="flex gap-4 text-sm text-gray-700 dark:text-gray-300">
			{
				programs.map((p) => (
					<span class="flex items-center gap-1.5">
						<span class:list={['inline-block h-3 w-3 rounded-[2px]', p.color]} />
						{p.key}
					</span>
				))
			}
		</span>
	</figcaption>
	{
		datasets.map((d) => (
			<div class="mt-5">
				<div class="text-sm">
					<span class="font-semibold text-gray-900 dark:text-gray-100">{d.name}</span>
					<span class="text-gray-600 dark:text-gray-400">, {d.about}</span>
				</div>
				<div class="mt-2 flex flex-col gap-3">
					{d.runs.map((r) => (
						<div
							class="grid grid-cols-1 items-center gap-x-4 gap-y-1 sm:grid-cols-[17rem_1fr]"
							title={`tippecanoe and manby ${r.options}`}
						>
							<span class="text-sm text-gray-700 sm:text-right dark:text-gray-300">{r.name}</span>
							<div class="flex flex-col gap-0.5 border-l border-[#c3c2b7] dark:border-[#383835]">
								{programs.map((p) => (
									<div
										class="flex items-center gap-2"
										title={`${p.key} ${r.options}: ${r[p.key][0]} s, ${r[p.key][1].toLocaleString('en')} MB peak memory`}
									>
										<div
											class:list={['h-3.5 rounded-r-[4px]', p.color]}
											style={`width: calc((100% - 3.5rem) * ${r[p.key][0] / max})`}
										/>
										<span class="text-xs whitespace-nowrap text-gray-600 tabular-nums dark:text-gray-400">
											{seconds(r[p.key][0])}
										</span>
									</div>
								))}
							</div>
						</div>
					))}
				</div>
			</div>
		))
	}
	<p class="mt-5 text-sm text-gray-600 dark:text-gray-400">
		On a Snapdragon X Elite with 12 cores, median of three runs, against tippecanoe 2.82.0. The
		tiles are the same. On the roads and the tracts to z12, much of tippecanoe's time goes to its
		SQLite step on this machine's compressed disk. <a class="text-accent-600 underline dark:text-accent-200" href={benchmarks}
			>The commands, and the same benchmarks on macOS</a
		>
	</p>
</figure>
