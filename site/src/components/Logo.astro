---
// manby's mark: a tile in quadrants, one of them split again, as the tile
// pyramid splits each tile into four at the next zoom.
const { class: className } = Astro.props;
---

<svg viewBox="0 0 32 32" aria-hidden="true" class={className}>
	<g class="fill-vp-text-1">
		<rect x="3" y="3" width="12" height="12" rx="2" />
		<rect x="17" y="3" width="12" height="12" rx="2" />
		<rect x="3" y="17" width="12" height="12" rx="2" />
	</g>
	<g class="fill-vp-brand-2">
		<rect x="17" y="17" width="5" height="5" rx="1.25" />
		<rect x="24" y="17" width="5" height="5" rx="1.25" />
		<rect x="17" y="24" width="5" height="5" rx="1.25" />
		<rect x="24" y="24" width="5" height="5" rx="1.25" />
	</g>
</svg>
