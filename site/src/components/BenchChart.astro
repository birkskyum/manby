---
// The headline benchmark: 4 million points to PMTiles with
// -zg --drop-densest-as-needed, medians of three runs (reference/benchmarks).
// manby's bar is the accent, tippecanoe's the gray it is measured against;
// both colors were checked for contrast and colorblind separation.
const machines = [
	{
		name: 'Apple M5 Max, macOS',
		runs: [
			{ program: 'tippecanoe', seconds: 61.4, mb: 2276 },
			{ program: 'manby', seconds: 3.44, mb: 919 },
		],
	},
	{
		name: 'Snapdragon X Elite, Linux',
		runs: [
			{ program: 'tippecanoe', seconds: 88.5, mb: 1088 },
			{ program: 'manby', seconds: 5.86, mb: 994 },
		],
	},
];
const max = 90;
const benchmarks = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/reference/benchmarks/`;
---

<figure class="not-content mt-10 mb-4">
	<figcaption class="text-base font-semibold text-gray-900 dark:text-gray-100">
		Time to tile 4 million points into PMTiles
	</figcaption>
	{
		machines.map((m) => (
			<div class="mt-5">
				<div class="text-sm text-gray-600 dark:text-gray-400">{m.name}</div>
				{m.runs.map((r) => (
					<div
						class="mt-1.5 grid grid-cols-[6.5rem_1fr] items-center gap-3"
						title={`${r.program} on ${m.name}: ${r.seconds} s, ${r.mb.toLocaleString('en')} MB peak memory`}
					>
						<span class="text-right text-sm text-gray-900 dark:text-gray-100">{r.program}</span>
						<div class="flex items-center gap-2 border-l border-[#c3c2b7] dark:border-[#383835]">
							<div
								class:list={[
									'h-5 rounded-r-[4px]',
									r.program === 'manby' ? 'bg-[#2a78d6] dark:bg-[#3987e5]' : 'bg-[#898781]',
								]}
								style={`width: calc((100% - 4.5rem) * ${r.seconds / max})`}
							/>
							<span class="text-sm whitespace-nowrap text-gray-600 tabular-nums dark:text-gray-400">
								{r.seconds.toFixed(1)} s
							</span>
						</div>
					</div>
				))}
			</div>
		))
	}
	<p class="mt-4 text-sm text-gray-600 dark:text-gray-400">
		<code>-zg --drop-densest-as-needed</code>, median of three runs, against tippecanoe 2.82.0.
		The tiles are the same. <a class="text-accent-600 underline dark:text-accent-200" href={benchmarks}
			>All the benchmarks</a
		>
	</p>
</figure>
