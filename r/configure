#!/bin/sh
# In webR, where R can't run programs, manby is built into the package from
# src/rust. Elsewhere the package runs the manby program and builds nothing.
#
# The Rust code is manby at the package's commit when R-universe builds it,
# the checkout that MANBY_SOURCE names, or else manby's crate of the
# package's version.
set -e
platform=$("${R_HOME}/bin/Rscript" -e 'cat(R.version$platform)')
case "$platform" in
wasm32-*)
	version=$(sed -n 's/^Version: *//p' DESCRIPTION)
	sha=$(sed -n 's/^RemoteSha: *//p' DESCRIPTION)
	if [ -n "$MANBY_SOURCE" ]; then
		manby="manby = { path = \"$MANBY_SOURCE\" }"
	elif [ -n "$sha" ]; then
		manby="manby = { git = \"https://github.com/birkskyum/manby\", rev = \"$sha\" }"
	else
		manby="manby = \"=$version\""
	fi
	echo "Building manby for webR: $manby"
	sed "s|@MANBY@|$manby|" src/rust/Cargo.toml.in >src/rust/Cargo.toml
	cp tools/Makevars.wasm src/Makevars
	;;
*)
	cp tools/Makevars.none src/Makevars
	;;
esac
