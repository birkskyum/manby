# manby built into the R package, in webR and from CRAN, where it runs in R's
# own process. configure writes Cargo.toml from this, with manby from the
# package's commit, a local checkout, crates.io or the vendored crates.
[package]
name = "manby-r"
version = "0.0.0"
edition = "2024"
publish = false

[lib]
crate-type = ["staticlib"]
path = "src/lib.rs"

# manby, without the program's allocator
[dependencies]
manby = { @MANBY@, default-features = false }

# A panic unwinds, to be caught by src/lib.rs, but in webR, whose Makevars
# makes it abort.

# not part of the repository's workspace
[workspace]
