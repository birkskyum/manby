# From CRAN on Windows: manby, built offline for Rtools' target from the
# crates that configure.win unpacked from rust/vendor.tar.xz, with at most two
# jobs, and linked into the package's library. Rust's build scripts ask for
# libgcc_eh, which Rtools doesn't have, so an empty one stands in, as in
# rextendr's template. The crates and the build are removed once it is linked.
TARGET = x86_64-pc-windows-gnu
LIBDIR = rust/target/$(TARGET)/release
STATLIB = $(LIBDIR)/libmanby_r.a
PKG_LIBS = -L$(LIBDIR) -lmanby_r -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll -lole32 -loleaut32 -lz
CARGO = PATH="$(PATH):$(USERPROFILE)/.cargo/bin" cargo

all: $(SHLIB) clean-rust

$(SHLIB): $(STATLIB)

$(STATLIB):
	@echo "Using `$(CARGO) --version`"
	@echo "Using `PATH="$(PATH):$(USERPROFILE)/.cargo/bin" rustc --version`"
	mkdir -p rust/.cargo-home/libgcc_mock
	touch rust/.cargo-home/libgcc_mock/libgcc_eh.a
	cd rust && CARGO_HOME="$$(pwd)/.cargo-home" LIBRARY_PATH="$(LIBRARY_PATH);$$(pwd)/.cargo-home/libgcc_mock" $(CARGO) build --target=$(TARGET) --release --lib --offline --locked -j 2 --target-dir target

clean-rust: $(SHLIB)
	rm -rf rust/target rust/vendor rust/manby rust/.cargo-home

.PHONY: $(STATLIB) clean-rust
